# =====================================================================
# Agenda Médica — variables de entorno
# Copiá este archivo a .env.local (desarrollo) o cargá estas variables en
# Vercel → Project → Settings → Environment Variables (producción).
# NUNCA subas valores reales al repositorio.
# =====================================================================

# --- Base de datos (Supabase → Project Settings → Database → Connection string → "Transaction pooler", puerto 6543)
# Solo la usa el servidor. Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexiones simultáneas por instancia (Vercel crea varias instancias; con el pooler 5 es suficiente)
DATABASE_POOL_MAX=5

# --- Supabase Auth (Supabase → Project Settings → API). Son públicas por diseño: la base no expone datos con ellas (RLS sin políticas).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta de servicio: SOLO para el script de creación de la cuenta de la médica (npm run create-admin).
# No hace falta cargarla en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación
# URL pública, sin barra final. Se usa en los enlaces de los correos.
APP_URL=https://turnos.tudominio.com.ar
# Secreto para firmar enlaces de gestión de turnos y formularios. Mínimo 32 caracteres aleatorios.
# Generalo con: openssl rand -base64 48
# Si lo cambiás, los enlaces de "Ver o modificar mi turno" ya enviados dejan de funcionar.
APP_SECRET=

# --- Tarea programada de recordatorios
# Secreto que pg_cron (Supabase) envía como "Authorization: Bearer <CRON_SECRET>". Mínimo 24 caracteres.
CRON_SECRET=

# --- Correo transaccional (Resend → API Keys). Permiso "Sending access" alcanza.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, ej.: Consultorio <turnos@tudominio.com.ar>
EMAIL_FROM=
# Opcional: a dónde llegan las respuestas de los pacientes
EMAIL_REPLY_TO=
